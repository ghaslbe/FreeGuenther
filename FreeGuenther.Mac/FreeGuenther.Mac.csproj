<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>FreeGuenther</AssemblyName>
    <RootNamespace>LmChat</RootNamespace>
    <Product>FreeGuenther</Product>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);IL2026;IL3050;IL2104;IL3053</NoWarn>
    <ImplicitUsings>true</ImplicitUsings>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>

    <!-- Läuft nur auf Apple Silicon -->
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- Die geteilte Logik und die Pakete arbeiten mit Reflection (JSON, Anthropic, MCP): nichts wegkürzen -->
    <LinkMode>None</LinkMode>
    <!-- .NET-eigener HTTP-Stack: Streaming ohne Pufferung, http:// zu lokalen Servern ohne App Transport Security -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

    <!-- Bei jeder Änderung hochzählen; gleiche Nummer wie die Windows-Version in LmChat/LmChat.csproj -->
    <Version>1.23.0</Version>
    <ApplicationVersion>1.23.0</ApplicationVersion>
    <ApplicationDisplayVersion>1.23.0</ApplicationDisplayVersion>
    <ApplicationId>de.guentherhaslbeck.freeguenther</ApplicationId>
    <ApplicationTitle>FreeGuenther</ApplicationTitle>
    <Authors>ghaslbe</Authors>
    <Copyright>Copyright (c) 2026 ghaslbe – MIT-Lizenz</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Logik ohne Oberfläche: dieselben Dateien wie die Windows-Version -->
    <Compile Include="..\LmChat\AutomationJob.cs" Link="Shared\AutomationJob.cs" />
    <Compile Include="..\LmChat\ChatStore.cs" Link="Shared\ChatStore.cs" />
    <Compile Include="..\LmChat\DocumentReader.cs" Link="Shared\DocumentReader.cs" />
    <Compile Include="..\LmChat\L.cs" Link="Shared\L.cs" />
    <Compile Include="..\LmChat\LlmSettings.cs" Link="Shared\LlmSettings.cs" />
    <Compile Include="..\LmChat\MailJob.cs" Link="Shared\MailJob.cs" />
    <Compile Include="..\LmChat\Plugins.cs" Link="Shared\Plugins.cs" />
    <Compile Include="..\LmChat\PromptGuard.cs" Link="Shared\PromptGuard.cs" />
    <Compile Include="..\LmChat\Providers.cs" Link="Shared\Providers.cs" />

    <EmbeddedResource Include="..\LmChat\Lang\*.json" LogicalName="lang.%(Filename).json" />
    <EmbeddedResource Include="..\LmChat\app-logo.png" LogicalName="app-logo.png" />
    <EmbeddedResource Include="..\plugins\wetter.json" LogicalName="plugin.wetter.json" />
    <EmbeddedResource Include="..\plugins\datum-uhrzeit.json" LogicalName="plugin.datum-uhrzeit.json" />
    <EmbeddedResource Include="..\plugins\dateien.json" LogicalName="plugin.dateien.json" />
    <EmbeddedResource Include="..\plugins\webhook.json" LogicalName="plugin.webhook.json" />
    <EmbeddedResource Include="..\plugins\webseite.json" LogicalName="plugin.webseite.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Markdig" Version="1.5.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
