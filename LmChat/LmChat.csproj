<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Name der .exe; Projektordner und Namespace heißen intern weiter LmChat -->
    <AssemblyName>FreeGuenther</AssemblyName>
    <RootNamespace>LmChat</RootNamespace>
    <Product>FreeGuenther</Product>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Windows-11-Look (Fluent) ist in WPF noch als experimentell markiert -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <!-- Eine einzige, eigenständige .exe -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Bei jeder Änderung hochzählen: Major.Minor.Patch -->
    <Version>1.21.0</Version>
    <Authors>ghaslbe</Authors>
    <Copyright>Copyright (c) 2026 ghaslbe – MIT-Lizenz</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="app-logo.png" />
    <!-- Mitgelieferte Plugins (dieselben Dateien bilden den Online-Katalog im Ordner plugins/) -->
    <!-- Sprachen: lang.de.json, lang.en.json … -->
    <EmbeddedResource Include="Lang\*.json" LogicalName="lang.%(Filename).json" />
    <EmbeddedResource Include="..\plugins\wetter.json" LogicalName="plugin.wetter.json" />
    <EmbeddedResource Include="..\plugins\datum-uhrzeit.json" LogicalName="plugin.datum-uhrzeit.json" />
    <EmbeddedResource Include="..\plugins\dateien.json" LogicalName="plugin.dateien.json" />
    <EmbeddedResource Include="..\plugins\webhook.json" LogicalName="plugin.webhook.json" />
    <EmbeddedResource Include="..\plugins\webseite.json" LogicalName="plugin.webseite.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Markdig" Version="1.5.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
