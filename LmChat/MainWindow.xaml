<Window x:Class="LmChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LM Chat" Height="720" Width="1050" MinHeight="450" MinWidth="700"
        ThemeMode="System" AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        Closing="Window_Closing">
    <TabControl Margin="8">

        <!-- ========== Chat ========== -->
        <TabItem Header="Chat">
            <Grid Margin="4,10,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Gespeicherte Chats -->
                <DockPanel Margin="0,0,12,0">
                    <Button x:Name="NewChatButton" DockPanel.Dock="Top" Content="+ Neuer Chat"
                            HorizontalAlignment="Stretch" Click="NewChat_Click"/>
                    <Button x:Name="DeleteChatButton" DockPanel.Dock="Bottom" Content="Chat löschen"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="DeleteChat_Click"/>
                    <ListBox x:Name="ChatList" Margin="0,8,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ChatList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Updated, StringFormat='dd.MM.yyyy HH:mm'}"
                                               FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ModelInfoText" Opacity="0.7" Margin="0,0,0,6"/>

                    <!-- Verlauf -->
                    <TextBox x:Name="ChatBox" Grid.Row="1"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="14" Padding="8"/>

                    <!-- Angehängtes Bild -->
                    <Border x:Name="AttachmentPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0"
                            Padding="6" CornerRadius="4" BorderThickness="1" BorderBrush="#60808080">
                        <DockPanel>
                            <Image x:Name="AttachmentImage" Height="64" MaxWidth="160" Stretch="Uniform"/>
                            <Button DockPanel.Dock="Right" Content="✕" ToolTip="Bild entfernen"
                                    VerticalAlignment="Center" Click="RemoveImage_Click"/>
                            <TextBlock x:Name="AttachmentText" VerticalAlignment="Center" Margin="10,0"/>
                        </DockPanel>
                    </Border>

                    <!-- Eingabe -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputBox" FontSize="14"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="70" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="InputBox_PreviewKeyDown"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                            <Button x:Name="ImageButton" Content="Bild …" MinWidth="90" Click="ImageButton_Click"/>
                            <Button x:Name="SendButton" Content="Senden" MinWidth="90" Margin="0,6,0,0"
                                    Click="Send_Click" Style="{StaticResource AccentButtonStyle}"/>
                            <Button x:Name="StopButton" Content="Stopp" MinWidth="90" Margin="0,6,0,0"
                                    IsEnabled="False" Click="Stop_Click"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Grid.Row="4" Margin="0,8,0,0">
                        <CheckBox x:Name="HistoryCheck" IsChecked="True"
                                  Content="Bisherigen Chatverlauf mitsenden"/>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"
                                   Text="Enter = senden, Umschalt+Enter = neue Zeile, Strg+V = Bild einfügen"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ========== Einstellungen ========== -->
        <TabItem Header="Einstellungen">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="8,16,8,8" MaxWidth="760" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0,12,0"/>
                        </Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Margin" Value="0,5"/>
                        </Style>
                    </Grid.Resources>

                    <TextBlock Grid.Row="0" Text="LM-Studio-Server"/>
                    <TextBox x:Name="ServerBox" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Grid.Row="1" Text="Modell"/>
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,5">
                        <Button DockPanel.Dock="Right" Content="Modelle laden" Margin="8,0,0,0"
                                Click="ReloadModels_Click"/>
                        <ComboBox x:Name="ModelCombo" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  HorizontalAlignment="Stretch" SelectionChanged="ModelCombo_SelectionChanged"/>
                    </DockPanel>
                    <TextBlock x:Name="ModelHint" Grid.Row="2" Grid.Column="1" Opacity="0.7" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Text="System-Prompt" VerticalAlignment="Top" Margin="0,10,12,0"/>
                    <TextBox x:Name="SystemPromptBox" Grid.Row="3" Grid.Column="1" Height="110"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Grid.Row="4" Text="Temperatur (0–2)"/>
                    <TextBox x:Name="TemperatureBox" Grid.Row="4" Grid.Column="1"/>

                    <TextBlock Grid.Row="5" Text="Top-P (0–1)"/>
                    <TextBox x:Name="TopPBox" Grid.Row="5" Grid.Column="1"/>

                    <TextBlock Grid.Row="6" Text="Top-K"/>
                    <TextBox x:Name="TopKBox" Grid.Row="6" Grid.Column="1"/>

                    <TextBlock Grid.Row="7" Text="Max. Tokens (−1 = unbegrenzt)"/>
                    <TextBox x:Name="MaxTokensBox" Grid.Row="7" Grid.Column="1"/>

                    <TextBlock Grid.Row="8" Text="Wiederholungsstrafe"/>
                    <TextBox x:Name="RepeatPenaltyBox" Grid.Row="8" Grid.Column="1"/>

                    <TextBlock Grid.Row="9" Grid.Column="1" Opacity="0.7" Margin="0,4,0,12" TextWrapping="Wrap"
                               Text="Leere Felder = Standardwert des Modells in LM Studio."/>

                    <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Speichern" MinWidth="110" Click="SaveSettings_Click"
                                Style="{StaticResource AccentButtonStyle}"/>
                        <TextBlock x:Name="SettingsStatus" Margin="12,0,0,0" Opacity="0.7"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
