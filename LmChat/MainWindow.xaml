                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Grid>
                </TabItem>

                <!-- ========== Datei-Automatik ========== -->
                <TabItem Header="Automatik">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,24,32,24" MaxWidth="860" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource ui.DateiAutomatik}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18" Text="{DynamicResource ui.AutomatikHinweis}"/>

                            <!-- Hinweis auf Prompt-Injection in einfacher Sprache -->
                            <Border Style="{StaticResource Card}" Background="#1FF59E0B" BorderBrush="#66F59E0B">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.InjectionTitel}"/>
                                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource ui.InjectionText}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="AutomationStartButton" Content="{DynamicResource ui.Starten}" Padding="18,6"
                                                    Style="{StaticResource AccentButtonStyle}" Click="AutomationStart_Click"
                                                    AutomationProperties.Name="Automatik starten"/>
                                            <Button x:Name="AutomationStopButton" Content="{DynamicResource ui.Stoppen}" Padding="18,6"
                                                    Visibility="Collapsed" Click="AutomationStop_Click" AutomationProperties.Name="Automatik stoppen"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.Auftrag}" VerticalAlignment="Center" Margin="0"/>
                                    </DockPanel>
                                    <TextBlock x:Name="AutomationStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                                    <StackPanel x:Name="AutomationSettingsPanel">
                                        <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.Ordner}"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{DynamicResource ui.OrdnerWaehlen}" Margin="8,0,0,0"
                                                    Click="AutomationPickFolder_Click"/>
                                            <TextBox x:Name="AutomationFolderBox" AutomationProperties.Name="Ordner"/>
                                        </DockPanel>

                                        <Grid Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.Dateien}"/>
                                                <ComboBox x:Name="AutomationKindCombo" SelectedIndex="1" AutomationProperties.Name="Dateityp">
                                                    <ComboBoxItem Content="{DynamicResource ui.AlleBilder}"/>
                                                    <ComboBoxItem Content="{DynamicResource ui.AllePdf}"/>
                                                    <ComboBoxItem Content="{DynamicResource ui.AlleExcel}"/>
                                                    <ComboBoxItem Content="{DynamicResource ui.AlleWord}"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.Ausgabe}"/>
                                                <ComboBox x:Name="AutomationOutputCombo" SelectedIndex="0" AutomationProperties.Name="Ausgabeformat">
                                                    <ComboBoxItem Content="txt"/>
                                                    <ComboBoxItem Content="json"/>
                                                    <ComboBoxItem Content="md"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.PruefenAlle}"/>
                                                <TextBox x:Name="AutomationIntervalBox" Text="30" AutomationProperties.Name="Intervall"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.Prompt}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource ui.PromptHinweis}"/>
                                        <TextBox x:Name="AutomationPromptBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Prompt"/>

                                        <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.AnbieterUndModell}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="AutomationProviderCombo" DisplayMemberPath="Label"
                                                      SelectionChanged="AutomationProvider_SelectionChanged" AutomationProperties.Name="Anbieter"/>
                                            <ComboBox x:Name="AutomationModelCombo" Grid.Column="2" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                      TextSearch.TextPath="Id" MaxDropDownHeight="420" AutomationProperties.Name="Modell"/>
                                        </Grid>
                                        <TextBlock x:Name="AutomationModelHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.Protokoll}"/>
                                    <ListBox x:Name="AutomationLogList" Height="240" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                             AutomationProperties.Name="Protokoll"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========== E-Mail-Automatik ========== -->
                <TabItem Header="Mail">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,24,32,24" MaxWidth="860" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource ui.EMailAutomatik}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18" Text="{DynamicResource ui.MailHinweis}"/>

                            <Border Style="{StaticResource Card}" Background="#1FF59E0B" BorderBrush="#66F59E0B">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.InjectionTitel}"/>
                                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource ui.InjectionText}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="{DynamicResource ui.VerbindungTesten}" Padding="14,6" Margin="0,0,8,0"
                                                    Click="MailTest_Click" AutomationProperties.Name="Verbindung testen"/>
                                            <Button x:Name="MailStartButton" Content="{DynamicResource ui.Starten}" Padding="18,6"
                                                    Style="{StaticResource AccentButtonStyle}" Click="MailStart_Click"
                                                    AutomationProperties.Name="Mail-Automatik starten"/>
                                            <Button x:Name="MailStopButton" Content="{DynamicResource ui.Stoppen}" Padding="18,6"
                                                    Visibility="Collapsed" Click="MailStop_Click" AutomationProperties.Name="Mail-Automatik stoppen"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.Postfach}" VerticalAlignment="Center" Margin="0"/>
                                    </DockPanel>
                                    <TextBlock x:Name="MailStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                                    <StackPanel x:Name="MailSettingsPanel">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.ImapServer}"/>
                                                <TextBox x:Name="MailHostBox" AutomationProperties.Name="IMAP-Server"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource SubHeading}" Text="Port"/>
                                                <TextBox x:Name="MailPortBox" Text="993" AutomationProperties.Name="Port"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.Verschluesselung}"/>
                                                <ComboBox x:Name="MailSecurityCombo" SelectedIndex="0" SelectionChanged="MailSecurity_SelectionChanged"
                                                          AutomationProperties.Name="Verschlüsselung">
                                                    <ComboBoxItem Content="SSL/TLS"/>
                                                    <ComboBoxItem Content="STARTTLS"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.Benutzername}"/>
                                                <TextBox x:Name="MailUserBox" AutomationProperties.Name="Benutzername"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.Passwort}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <PasswordBox x:Name="MailPasswordBox" AutomationProperties.Name="Passwort"/>
                                                    <TextBox x:Name="MailPasswordPlain" Visibility="Collapsed" FontFamily="Cascadia Mono, Consolas"/>
                                                    <ToggleButton x:Name="MailPasswordReveal" Grid.Column="1" Margin="6,0,0,0" Padding="10,0"
                                                                  ToolTip="{DynamicResource ui.SchluesselAnzeigenBzwWiederVerbergen}"
                                                                  AutomationProperties.Name="Passwort anzeigen">
                                                        <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                                    </ToggleButton>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{DynamicResource ui.PasswortHinweis}"/>
                                        <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.AbsenderAdresse}"/>
                                        <TextBox x:Name="MailFromBox" AutomationProperties.Name="Absender-Adresse"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{DynamicResource ui.AbsenderHinweis}"/>

                                        <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.Prompt}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource ui.MailPromptHinweis}"/>
                                        <TextBox x:Name="MailPromptBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Prompt"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.PruefenAlle}"/>
                                                <TextBox x:Name="MailIntervalBox" Text="60" AutomationProperties.Name="Intervall"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.Anbieter}"/>
                                                <ComboBox x:Name="MailProviderCombo" DisplayMemberPath="Label"
                                                          SelectionChanged="MailProvider_SelectionChanged" AutomationProperties.Name="Anbieter"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.Modell}"/>
                                                <ComboBox x:Name="MailModelCombo" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                          TextSearch.TextPath="Id" MaxDropDownHeight="420" AutomationProperties.Name="Modell"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="MailModelHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.Protokoll}"/>
                                    <ListBox x:Name="MailLogList" Height="240" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                             AutomationProperties.Name="Protokoll"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
