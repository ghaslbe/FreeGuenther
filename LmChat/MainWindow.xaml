<Window x:Class="LmChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LM Chat" Height="760" Width="1180" MinHeight="500" MinWidth="820"
        ThemeMode="System" AllowDrop="True" Icon="app.ico"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SubHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="22"/>
        </Style>

        <!-- Karte wie im Dashboard-Design: abgerundet, dezente Kontur, weicher Schatten -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22,18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kachel mit farbigem Hintergrund (Kennzahlen oben in den Einstellungen) -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Navigationspunkt in der Seitenleiste -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Padding="12,9" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}"
                                           FontSize="16" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schlichter Icon-Knopf (Bild anhängen, Stopp, Löschen) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Padding="9,7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Runder Senden-Knopf in Akzentfarbe -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="38" Height="38" CornerRadius="19"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Randloses Eingabefeld (sitzt in der Eingabekarte) -->
        <Style x:Key="PlainTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                      Background="Transparent" Focusable="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chat in der Liste: dezente Hervorhebung statt Vollfarbe -->
        <Style x:Key="ChatListItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="8" Padding="10,8" Margin="0,1" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inhaltsseiten (Tab-Köpfe ausgeblendet; umgeschaltet wird über die Seitenleiste) -->
        <Style x:Key="HiddenTab" TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Seitenleiste ================= -->
        <DockPanel Margin="16,14,12,16">
            <!-- Logo -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,18">
                <Image Source="app-logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LM Chat" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SidebarVersion" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <Button x:Name="NewChatButton" DockPanel.Dock="Top" HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}" Padding="0,8" Margin="0,0,0,14" Click="NewChat_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="Neuer Chat" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Navigation -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <RadioButton x:Name="NavChat" Style="{StaticResource NavItem}" Tag="&#xE8BD;" Content="Chat"
                             Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Einstellungen"
                             Checked="Nav_Checked"/>
                <RadioButton x:Name="NavHelp" Style="{StaticResource NavItem}" Tag="&#xE897;" Content="Hilfe"
                             Checked="Nav_Checked"/>
            </StackPanel>

            <!-- Aktives Modell (unten) -->
            <Border DockPanel.Dock="Bottom" CornerRadius="12" Padding="12,10" Margin="0,12,0,0"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" Cursor="Hand"
                    MouseLeftButtonUp="ModelCard_Click" ToolTip="Anbieter und Modell ändern">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="&#xE99A;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ProviderInfoText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ModelInfoText" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Suche + Chatliste -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBox x:Name="ChatSearchBox" Padding="32,6,8,6" TextChanged="ChatSearch_TextChanged"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="11,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="Chats durchsuchen" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding Text.IsEmpty, ElementName=ChatSearchBox, Converter={StaticResource BoolToVis}}"/>
            </Grid>
            <ListBox x:Name="ChatList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ChatListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ChatList_SelectionChanged">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="10,12,0,4"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ================= Inhalt ================= -->
        <Border Grid.Column="1" Margin="0,8,8,8" CornerRadius="14"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <TabControl x:Name="MainTabs" BorderThickness="0" Background="Transparent" Padding="0"
                        ItemContainerStyle="{StaticResource HiddenTab}">

                <!-- ========== Chat ========== -->
                <TabItem Header="Chat">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Kopfzeile -->
                        <DockPanel Margin="28,16,20,4">
                            <Button x:Name="DeleteChatButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    ToolTip="Diesen Chat löschen" Click="DeleteChat_Click">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                            </Button>
                            <TextBlock x:Name="ChatTitleText" Text="Neuer Chat" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <!-- Verlauf (mittige Lesespalte) -->
                        <RichTextBox x:Name="ChatBox" Grid.Row="1" MaxWidth="860" HorizontalAlignment="Stretch"
                                     IsReadOnly="True" IsDocumentEnabled="True" Background="Transparent"
                                     BorderThickness="0" VerticalScrollBarVisibility="Auto"
                                     FontSize="15" Padding="24,8,24,8">
                            <FlowDocument PagePadding="0" FontFamily="Segoe UI Variable Text, Segoe UI" LineHeight="24"
                                          TextAlignment="Left"/>
                        </RichTextBox>

                        <!-- Startansicht für einen leeren Chat -->
                        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsHitTestVisible="False" Margin="24">
                            <Image Source="app-logo.png" Width="56" Height="56" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Wie kann ich helfen?" FontSize="30" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyStateHint" FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Stell eine Frage oder häng ein Bild an – z. B. per Strg+V."/>
                        </StackPanel>

                        <!-- Eingabekarte -->
                        <Border Grid.Row="2" MaxWidth="860" Margin="24,8,24,6" CornerRadius="20" Padding="16,12,12,10"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270" Opacity="0.10"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Angehängtes Bild -->
                                <Border x:Name="AttachmentPanel" Visibility="Collapsed" Margin="0,0,0,8" Padding="6"
                                        CornerRadius="10" HorizontalAlignment="Left"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="AttachmentImage" Height="56" MaxWidth="140" Stretch="Uniform"/>
                                        <TextBlock x:Name="AttachmentText" VerticalAlignment="Center" Margin="10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Button Style="{StaticResource IconButton}" ToolTip="Bild entfernen"
                                                VerticalAlignment="Center" Click="RemoveImage_Click">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <TextBox x:Name="InputBox" FontSize="15" Style="{StaticResource PlainTextBox}"
                                             Padding="2,4" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="48" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                             PreviewKeyDown="InputBox_PreviewKeyDown"/>
                                    <TextBlock Text="Nachricht schreiben …" FontSize="15" Margin="4,6,0,0" IsHitTestVisible="False"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding Text.IsEmpty, ElementName=InputBox, Converter={StaticResource BoolToVis}}"/>
                                </Grid>

                                <DockPanel Margin="0,6,0,0">
                                    <Button x:Name="ImageButton" Style="{StaticResource IconButton}" Click="ImageButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Bild" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <CheckBox x:Name="HistoryCheck" IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center"
                                              Content="Verlauf mitsenden"
                                              ToolTip="Mit Haken kennt das Modell den bisherigen Chat (Gespräch). Ohne Haken nur die aktuelle Nachricht."/>
                                    <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource SendButtonStyle}"
                                            ToolTip="Senden (Enter)" Click="Send_Click"/>
                                    <Button x:Name="StopButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                            Margin="0,0,6,0" Visibility="Collapsed" ToolTip="Antwort abbrechen" Click="Stop_Click">
                                        <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                    </Button>
                                    <Grid/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="StatusText" Grid.Row="3" HorizontalAlignment="Center" Margin="24,0,24,10"
                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Enter = senden · Umschalt+Enter = neue Zeile · Strg+V = Bild einfügen"/>
                    </Grid>
                </TabItem>

                <!-- ========== Einstellungen ========== -->
                <TabItem Header="Einstellungen">
                    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,24,32,24" MaxWidth="860" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource PageTitle}" Text="Einstellungen"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18"
                                       Text="Wo das Sprachmodell läuft, welches Modell antwortet und wie es antwortet."/>

                            <!-- Kacheln -->
                            <UniformGrid Columns="3" Margin="0,0,-12,20">
                                <Border Style="{StaticResource Tile}" Background="#1F3B82F6">
                                    <StackPanel>
                                        <TextBlock x:Name="TileProvider" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Aktiver Anbieter" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}" Background="#1F8B5CF6">
                                    <StackPanel>
                                        <TextBlock x:Name="TileModel" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TileModelHint" Text="Aktives Modell" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}" Background="#1FF97316">
                                    <StackPanel>
                                        <TextBlock x:Name="TileChats" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="Gespeicherte Chats" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Karte: Anbieter -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Anbieter"/>
                                    <TextBlock Style="{StaticResource Hint}">
                                        Lokal auf deinem Rechner bzw. im Netzwerk (LM Studio, Ollama) oder bei einem Online-Dienst
                                        (OpenAI, Anthropic, OpenRouter). Jeder Anbieter merkt sich seine eigene Adresse, seinen Schlüssel
                                        und sein Modell.
                                    </TextBlock>
                                    <ComboBox x:Name="ProviderCombo" DisplayMemberPath="Label"
                                              SelectionChanged="ProviderCombo_SelectionChanged"/>
                                    <TextBlock x:Name="ProviderHint" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
                                    <TextBlock x:Name="ProviderLinks" TextWrapping="Wrap"/>

                                    <TextBlock Style="{StaticResource SubHeading}" Text="Server-Adresse"/>
                                    <TextBlock Style="{StaticResource Hint}">
                                        Normalerweise passt der Standard. Für einen anderen Rechner im Netzwerk dessen Adresse eintragen,
                                        z. B. <Run FontFamily="Consolas" Text="http://192.168.178.191:1234"/>.
                                    </TextBlock>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Standard" Margin="8,0,0,0" Click="DefaultServer_Click"/>
                                        <TextBox x:Name="ServerBox"/>
                                    </DockPanel>

                                    <StackPanel x:Name="ApiKeyPanel">
                                        <TextBlock Style="{StaticResource SubHeading}" Text="API-Schlüssel"/>
                                        <TextBlock Style="{StaticResource Hint}">
                                            Den Schlüssel bekommst du in deinem Konto beim Anbieter:
                                            <Hyperlink x:Name="KeyLink" RequestNavigate="Link_RequestNavigate"><Run x:Name="KeyLinkText"/></Hyperlink>.
                                            Er wird verschlüsselt gespeichert und ist nur mit deinem Windows-Konto lesbar.
                                            Achtung: Bei Online-Diensten werden deine Nachrichten und Bilder an den Anbieter gesendet,
                                            und die Nutzung kostet in der Regel Geld.
                                        </TextBlock>
                                        <PasswordBox x:Name="ApiKeyBox"/>
                                    </StackPanel>

                                    <StackPanel x:Name="RegionPanel">
                                        <TextBlock Style="{StaticResource SubHeading}" Text="Standort der Rechenzentren"/>
                                        <TextBlock Style="{StaticResource Hint}">
                                            Legt fest, wo deine Anfragen verarbeitet werden. Die Modellliste zeigt dann nur Modelle, die in der
                                            gewählten Region laufen.<LineBreak/>
                                            <Run FontWeight="SemiBold" Text="Über Hoster-Auswahl (jeder Tarif):"/> Die App lässt nur Hoster-Endpunkte
                                            zu, deren Standort bekannt ist und in der Region liegt (z. B. „mistral/eu“, „amazon-bedrock/eu-central-1“).
                                            Andere Hoster sind gesperrt, es gibt keine Ausweichhoster. Die Standortangaben stammen von OpenRouter und
                                            den Hostern selbst und sind nicht garantiert. Beim ersten Laden werden alle Modelle geprüft, das dauert
                                            etwas.<LineBreak/>
                                            <Run FontWeight="SemiBold" Text="Garantiert (In-Region-Routing):"/> OpenRouter selbst stellt sicher, dass die
                                            Anfrage die Region nicht verlässt. Das gibt es nur im Business-Tarif
                                            (<Hyperlink NavigateUri="https://openrouter.ai/docs/guides/features/sovereign-ai"
                                                        RequestNavigate="Link_RequestNavigate">Details</Hyperlink>), sonst kommt der Fehler HTTP 403.
                                        </TextBlock>
                                        <ComboBox x:Name="RegionCombo" DisplayMemberPath="Label" SelectedValuePath="Code"
                                                  SelectionChanged="RegionCombo_SelectionChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Karte: Modell -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Modell"/>
                                    <TextBlock Style="{StaticResource Hint}">
                                        Die Liste kommt direkt vom Anbieter („Liste aktualisieren“, nachdem Adresse und ggf. Schlüssel stimmen).
                                        <Run FontWeight="SemiBold" Text="🖼"/> = versteht Bilder,
                                        <Run FontWeight="SemiBold" Text="●"/> = ist gerade geladen und antwortet sofort.
                                        Im aufgeklappten Feld kannst du die Anfangsbuchstaben tippen, um schnell zu springen.
                                    </TextBlock>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Liste aktualisieren" Margin="8,0,0,0"
                                                Click="ReloadModels_Click"/>
                                        <ComboBox x:Name="ModelCombo" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                  TextSearch.TextPath="Id" MaxDropDownHeight="420"
                                                  HorizontalAlignment="Stretch" SelectionChanged="ModelCombo_SelectionChanged"/>
                                    </DockPanel>
                                    <TextBlock x:Name="ModelHint" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Karte: System-Prompt -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="System-Prompt"/>
                                    <TextBlock Style="{StaticResource Hint}">
                                        Eine feste Anweisung, die das Modell vor jedem Chat bekommt, z. B.
                                        „Antworte immer auf Deutsch und möglichst kurz.“ Leer lassen, wenn du keine brauchst.
                                    </TextBlock>
                                    <TextBox x:Name="SystemPromptBox" Height="100"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>

                            <!-- Karte: Feineinstellungen -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Feineinstellungen"/>
                                    <TextBlock Style="{StaticResource Hint}">
                                        Setze einen Haken, um einen eigenen Wert zu verwenden. Ohne Haken gilt der Standardwert
                                        des Modells. Das ist meistens die beste Wahl. Ausgegraute Einstellungen kennt der gewählte
                                        Anbieter nicht; sie werden dann nicht gesendet.
                                    </TextBlock>
                                    <StackPanel x:Name="ParamsPanel"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Speichern" MinWidth="130" Padding="0,8" Click="SaveSettings_Click"
                                        Style="{StaticResource AccentButtonStyle}"/>
                                <Button Content="Alles auf Standard" Margin="8,0,0,0" Click="ResetParams_Click"/>
                                <TextBlock x:Name="SettingsStatus" Margin="14,0,0,0" MaxWidth="520"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========== Hilfe ========== -->
                <TabItem Header="Hilfe">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,24,32,24" MaxWidth="860" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource PageTitle}" Text="Hilfe"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,0,0,18"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                Ein einfacher Chat-Client für lokale und Online-Sprachmodelle. <Run x:Name="VersionRun"/>
                                Projekt auf GitHub:
                                <Hyperlink NavigateUri="https://github.com/ghaslbe/lmstudioChatWindows"
                                           RequestNavigate="Link_RequestNavigate">github.com/ghaslbe/lmstudioChatWindows</Hyperlink>
                                ·
                                <Hyperlink NavigateUri="https://github.com/ghaslbe/lmstudioChatWindows/releases/latest"
                                           RequestNavigate="Link_RequestNavigate">Neueste Version</Hyperlink>
                            </TextBlock>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Erste Schritte"/>
                                    <TextBlock Style="{StaticResource Body}">
                                        1. Unter „Einstellungen“ den Anbieter wählen. Die Links darunter führen zur Website, zu den Schlüsseln und Preisen.<LineBreak/>
                                        2. Bei lokalen Anbietern ggf. die Server-Adresse anpassen, bei Online-Diensten den API-Schlüssel eintragen.<LineBreak/>
                                        3. „Liste aktualisieren“, ein Modell wählen und „Speichern“ klicken.<LineBreak/>
                                        4. Unter „Chat“ eine Frage eintippen und Enter drücken. Die Antwort erscheint Wort für Wort.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Anbieter"/>
                                    <TextBlock Style="{StaticResource Body}">
                                        <Run FontWeight="SemiBold" Text="LM Studio"/> (lokal, Standard http://localhost:1234): Server unter „Developer“ starten;
                                        für andere Rechner „Serve on Local Network“ einschalten.<LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Ollama"/> (lokal, Standard http://localhost:11434): Modelle mit „ollama pull“ laden;
                                        für andere Rechner OLLAMA_HOST=0.0.0.0 setzen.<LineBreak/>
                                        <Run FontWeight="SemiBold" Text="OpenAI"/>, <Run FontWeight="SemiBold" Text="Anthropic (Claude)"/>,
                                        <Run FontWeight="SemiBold" Text="OpenRouter"/> (online): brauchen einen API-Schlüssel und kosten pro Nutzung.
                                        Nachrichten und Bilder werden dabei an den jeweiligen Dienst gesendet.<LineBreak/>
                                        Bei OpenRouter kannst du den <Run FontWeight="SemiBold" Text="Standort der Rechenzentren"/> festlegen.
                                        Über die Hoster-Auswahl (Europa, Deutschland oder USA) geht das mit jedem Tarif, beruht aber auf den
                                        Standortangaben der Hoster. Garantiert (Europa oder USA) gibt es nur im Business-Tarif. Die Modellliste
                                        zeigt jeweils nur Modelle, die in der Region laufen.<LineBreak/>
                                        Die API-Schlüssel werden verschlüsselt gespeichert und sind nur mit deinem Windows-Konto lesbar.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Bedienung"/>
                                    <TextBlock Style="{StaticResource Body}">
                                        <Run FontWeight="SemiBold" Text="Enter"/> – Nachricht senden<LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Umschalt + Enter"/> – neue Zeile<LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Strg + V"/> – Bild aus der Zwischenablage anhängen (z. B. Screenshot)<LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Stopp-Knopf"/> – laufende Antwort abbrechen<LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Suchfeld links"/> – Chats nach Titel filtern<LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Zeile unter jeder Antwort"/> – Anbieter, Modell, Geschwindigkeit
                                        (Token/s), Token-Verbrauch (in/out) und Dauer, soweit der Anbieter das meldet
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Chats und Verlauf"/>
                                    <TextBlock Style="{StaticResource Body}">
                                        Jeder Chat wird automatisch gespeichert und erscheint links in der Liste, gruppiert nach Datum.
                                        Ein Klick darauf öffnet ihn wieder, „Neuer Chat“ beginnt ein neues Gespräch, der Papierkorb oben
                                        rechts löscht den geöffneten Chat.<LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Verlauf mitsenden:"/>
                                        Mit Haken (Standard) kennt das Modell alles, was vorher im Chat gesagt wurde, so kann man ein Gespräch führen.
                                        Ohne Haken bekommt es nur die aktuelle Nachricht. Das ist schneller und gut für einzelne, unabhängige Fragen.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Bilder"/>
                                    <TextBlock Style="{StaticResource Body}">
                                        Modelle mit 🖼 verstehen Bilder. Ein Bild hängst du mit „Bild“, mit Strg + V oder durch Hineinziehen ins Fenster an.
                                        Schreib dazu, was du wissen willst, z. B. „Lies mal das Bild aus“.
                                        Große Bilder werden automatisch verkleinert. Im Chat erscheint eine Vorschau; ein Klick darauf öffnet das Bild in voller Größe.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Wenn es nicht klappt"/>
                                    <TextBlock Style="{StaticResource Body}">
                                        <Run FontWeight="SemiBold" Text="„Fehler“ / keine Verbindung:"/>
                                        Lokal: Läuft LM Studio bzw. Ollama? Ist der Zugriff aus dem Netzwerk erlaubt? Stimmt die Adresse? Lässt die Firewall den Port durch?
                                        Online: Stimmt der API-Schlüssel, und ist beim Anbieter Guthaben vorhanden?<LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Fehler wegen Temperatur o. Ä.:"/>
                                        Manche Modelle (z. B. Reasoning-Modelle) lehnen einzelne Feineinstellungen ab – dort den Haken entfernen.<LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Modellliste ist leer:"/>
                                        In den Einstellungen „Liste aktualisieren“ klicken, nachdem die Adresse stimmt.<LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Erste Antwort dauert lange:"/>
                                        LM Studio lädt das Modell erst. Danach geht es schneller.<LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Bild-Knopf ausgegraut:"/>
                                        Das gewählte Modell versteht keine Bilder. Wähle eines mit 🖼.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Daten"/>
                                    <TextBlock Style="{StaticResource Body}">
                                        Chats, Bilder und Einstellungen liegen nur auf diesem Rechner in
                                        <Run FontFamily="Consolas" Text="%LOCALAPPDATA%\LmChat\chats.db"/>.
                                        Gesendet wird ausschließlich an den eingestellten Anbieter.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Lizenz und Haftungsausschluss"/>
                                    <TextBlock Style="{StaticResource Body}">
                                        Diese Software steht unter der <Run FontWeight="SemiBold" Text="MIT-Lizenz"/>.
                                        Sie darf frei genutzt, verändert und weitergegeben werden.<LineBreak/>
                                        Sie wird <Run FontWeight="SemiBold" Text="ohne jede Gewährleistung"/> bereitgestellt. Die Autoren übernehmen
                                        <Run FontWeight="SemiBold" Text="keinerlei Haftung"/> für Schäden, Datenverlust oder sonstige Folgen der Nutzung.
                                        Antworten von KI-Modellen können falsch sein. Prüfe wichtige Informationen selbst.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Hint}" FontFamily="Consolas" FontSize="11" Margin="0,12,0,0">
                                        MIT License – Copyright (c) 2026 ghaslbe<LineBreak/><LineBreak/>
                                        Permission is hereby granted, free of charge, to any person obtaining a copy of this software and
                                        associated documentation files (the "Software"), to deal in the Software without restriction, including
                                        without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
                                        copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the
                                        following conditions:<LineBreak/><LineBreak/>
                                        The above copyright notice and this permission notice shall be included in all copies or substantial
                                        portions of the Software.<LineBreak/><LineBreak/>
                                        THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT
                                        LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO
                                        EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER
                                        IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE
                                        USE OR OTHER DEALINGS IN THE SOFTWARE.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
