<Window x:Class="LmChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ui.FreeGuenther}" Height="760" Width="1180" MinHeight="500" MinWidth="820"
        ThemeMode="System" AllowDrop="True" Icon="app.ico"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SubHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="22"/>
        </Style>

        <!-- Karte wie im Dashboard-Design: abgerundet, dezente Kontur, weicher Schatten -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22,18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kachel mit farbigem Hintergrund (Kennzahlen oben in den Einstellungen) -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Navigationspunkt in der Seitenleiste -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Padding="12,9" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}"
                                           FontSize="16" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schlichter Icon-Knopf (Bild anhängen, Stopp, Löschen) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Runder Senden-Knopf in Akzentfarbe -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="38" Height="38" CornerRadius="19"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Randloses Eingabefeld (sitzt in der Eingabekarte) -->
        <Style x:Key="PlainTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                      Background="Transparent" Focusable="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rechtsklick-Menü eines Chats in der Liste -->
        <ContextMenu x:Key="ChatMenu" x:Shared="False">
            <MenuItem Header="{DynamicResource ui.ChatLoeschen}" Click="DeleteChatItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Chat in der Liste: dezente Hervorhebung, Papierkorb beim Darüberfahren -->
        <Style x:Key="ChatListItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContextMenu" Value="{StaticResource ChatMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="8" Padding="10,8,4,8" Margin="0,1" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Button x:Name="DeleteItemButton" Grid.Column="1" Style="{StaticResource IconButton}"
                                        Margin="0,-6" Padding="0" Visibility="Hidden" ToolTip="{DynamicResource ui.ChatLoeschen}"
                                        Click="DeleteChatItem_Click">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="DeleteItemButton" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                <Setter TargetName="DeleteItemButton" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inhaltsseiten (Tab-Köpfe ausgeblendet; umgeschaltet wird über die Seitenleiste) -->
        <Style x:Key="HiddenTab" TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Seitenleiste ================= -->
        <DockPanel Margin="16,14,12,16">
            <!-- Logo -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,18">
                <Image Source="app-logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource ui.FreeGuenther}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SidebarVersion" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <Button x:Name="NewChatButton" DockPanel.Dock="Top" HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}" Padding="0,8" Margin="0,0,0,14" Click="NewChat_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource ui.NeuerChat}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Navigation -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <RadioButton x:Name="NavChat" Style="{StaticResource NavItem}" Tag="&#xE8BD;" Content="{DynamicResource ui.Chat}"
                             Checked="Nav_Checked"/>
                <!-- Punkt rechts: rot = Automatik läuft, grau = aus -->
                <RadioButton x:Name="NavAutomation" Style="{StaticResource NavItem}" Tag="&#xE8B7;"
                             AutomationProperties.Name="{DynamicResource ui.DateiAutomatik}" Checked="Nav_Checked">
                    <DockPanel>
                        <Ellipse x:Name="AutomationDot" DockPanel.Dock="Right" Width="8" Height="8" Margin="8,0,2,0"
                                 VerticalAlignment="Center" Fill="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{DynamicResource ui.DateiAutomatik}"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton x:Name="NavMail" Style="{StaticResource NavItem}" Tag="&#xE715;"
                             AutomationProperties.Name="{DynamicResource ui.EMailAutomatik}" Checked="Nav_Checked">
                    <DockPanel>
                        <Ellipse x:Name="MailDot" DockPanel.Dock="Right" Width="8" Height="8" Margin="8,0,2,0"
                                 VerticalAlignment="Center" Fill="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{DynamicResource ui.EMailAutomatik}"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="{DynamicResource ui.Einstellungen}"
                             Checked="Nav_Checked"/>
                <RadioButton x:Name="NavUsage" Style="{StaticResource NavItem}" Tag="&#xE9D2;" Content="{DynamicResource ui.Verbrauch}"
                             Checked="Nav_Checked"/>
                <RadioButton x:Name="NavPlugins" Style="{StaticResource NavItem}" Tag="&#xEA86;" Content="{DynamicResource ui.Plugins}"
                             Checked="Nav_Checked"/>
                <RadioButton x:Name="NavCompare" Style="{StaticResource NavItem}" Tag="&#xE8A9;" Content="{DynamicResource ui.ModelleVergleichen}"
                             Checked="Nav_Checked"/>
                <RadioButton x:Name="NavHelp" Style="{StaticResource NavItem}" Tag="&#xE897;" Content="{DynamicResource ui.Hilfe}"
                             Checked="Nav_Checked"/>
            </StackPanel>

            <!-- Aktives Modell (unten) -->
            <Border DockPanel.Dock="Bottom" CornerRadius="12" Padding="12,10" Margin="0,12,0,0"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" Cursor="Hand"
                    MouseLeftButtonUp="ModelCard_Click" ToolTip="{DynamicResource ui.AnbieterUndModellAendern}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="&#xE99A;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ProviderInfoText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ModelInfoText" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Suche + Chatliste -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBox x:Name="ChatSearchBox" Padding="32,6,8,6" TextChanged="ChatSearch_TextChanged"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="11,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{DynamicResource ui.ChatsDurchsuchen}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding Text.IsEmpty, ElementName=ChatSearchBox, Converter={StaticResource BoolToVis}}"/>
            </Grid>
            <ListBox x:Name="ChatList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ChatListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ChatList_SelectionChanged" PreviewKeyDown="ChatList_PreviewKeyDown">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="10,12,0,4"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ================= Inhalt ================= -->
        <Border Grid.Column="1" Margin="0,8,8,8" CornerRadius="14"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <TabControl x:Name="MainTabs" BorderThickness="0" Background="Transparent" Padding="0"
                        ItemContainerStyle="{StaticResource HiddenTab}">

                <!-- ========== Chat ========== -->
                <TabItem Header="{DynamicResource ui.Chat}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Kopfzeile -->
                        <DockPanel Margin="28,16,20,4">
                            <Button x:Name="DeleteChatButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    ToolTip="{DynamicResource ui.DiesenChatLoeschen}" Click="DeleteChat_Click">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                            </Button>
                            <Button x:Name="ExportChatButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    ToolTip="{DynamicResource ui.ChatExportierenAlsMarkdownOder}" Click="ExportChat_Click"
                                    AutomationProperties.Name="{DynamicResource ui.ChatExportieren}">
                                <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                            </Button>
                            <TextBlock x:Name="ChatTitleText" Text="{DynamicResource ui.NeuerChat}" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <!-- Verlauf (mittige Lesespalte) -->
                        <RichTextBox x:Name="ChatBox" Grid.Row="1" MaxWidth="860" HorizontalAlignment="Stretch"
                                     IsReadOnly="True" IsDocumentEnabled="True" Background="Transparent"
                                     BorderThickness="0" VerticalScrollBarVisibility="Auto"
                                     FontSize="15" Padding="24,8,24,8">
                            <FlowDocument PagePadding="0" FontFamily="Segoe UI Variable Text, Segoe UI" LineHeight="24"
                                          TextAlignment="Left"/>
                        </RichTextBox>

                        <!-- Startansicht für einen leeren Chat -->
                        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsHitTestVisible="False" Margin="24">
                            <Image Source="app-logo.png" Width="56" Height="56" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{DynamicResource ui.WieKannIchHelfen}" FontSize="30" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyStateHint" FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{DynamicResource ui.StellEineFrageOderHaeng}"/>
                        </StackPanel>

                        <!-- Erster Start bzw. nichts eingerichtet: an die Hand nehmen statt Chat -->
                        <ScrollViewer x:Name="SetupPanel" Grid.Row="1" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <StackPanel MaxWidth="760" Margin="32,8,32,24" VerticalAlignment="Center">
                                <Image Source="app-logo.png" Width="56" Height="56" Margin="0,0,0,14"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{DynamicResource ui.WillkommenBeiFreeGuenther}" FontSize="30" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI" HorizontalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Body}" HorizontalAlignment="Center" TextAlignment="Center"
                                           Margin="0,8,0,20" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{DynamicResource ui.ZumChattenBrauchstDuEin}"/>
                                </TextBlock>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.LokalAufDeinemRechnerKostenlos}"/>
                                        <TextBlock Style="{StaticResource Body}">
                                            <Run Text="{DynamicResource ui.DeineTexteVerlassenDenRechner}"/>
                                        </TextBlock>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Tag="LmStudio" Click="SetupProvider_Click" Margin="0,0,8,0" Padding="14,6"
                                                    Style="{StaticResource AccentButtonStyle}" Content="{DynamicResource ui.LMStudioEinrichten}"/>
                                            <Button Tag="Ollama" Click="SetupProvider_Click" Padding="14,6" Content="{DynamicResource ui.OllamaEinrichten}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.OnlineMitAPISchluessel}"/>
                                        <TextBlock Style="{StaticResource Body}">
                                            <Run Text="{DynamicResource ui.DieGrossenSchnellenModelleLaufen}"/>
                                            <Run FontWeight="SemiBold" Text="{DynamicResource ui.APISchluessel}"/> <Run Text="{DynamicResource ui.EineArtPasswortFuerProgramme}"/>
                                            <Run FontWeight="SemiBold" Text="{DynamicResource ui.OpenRouter}"/> <Run Text="{DynamicResource ui.IstFuerDenAnfangAm}"/>
                                        </TextBlock>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Tag="OpenRouter" Click="SetupProvider_Click" Margin="0,0,8,0" Padding="14,6"
                                                    Style="{StaticResource AccentButtonStyle}" Content="{DynamicResource ui.OpenRouterEinrichtenEmpfohlen}"/>
                                            <Button Tag="OpenAI" Click="SetupProvider_Click" Margin="0,0,8,0" Padding="14,6" Content="{DynamicResource ui.OpenAI}"/>
                                            <Button Tag="Anthropic" Click="SetupProvider_Click" Padding="14,6" Content="{DynamicResource ui.AnthropicClaude}"/>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Foreground="#B45309">
                                            <Run Text="{DynamicResource ui.SetzeBeimAnbieterUnbedingtEin}"/>
                                            <Hyperlink Click="ShowHelp_Click"><Run Text="{DynamicResource ui.WarumStehtInDerHilfe}"/></Hyperlink>.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Eingabekarte -->
                        <Border x:Name="InputCard" Grid.Row="2" MaxWidth="860" Margin="24,8,24,6" CornerRadius="20" Padding="16,12,12,10"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270" Opacity="0.10"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Persona dieses Chats -->
                                <Border x:Name="PersonaPanel" Visibility="Collapsed" Margin="0,0,0,8" Padding="10,2,2,2"
                                        CornerRadius="10" HorizontalAlignment="Left" Background="#1F8B5CF6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PersonaText" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource IconButton}" ToolTip="{DynamicResource ui.PersonaEntfernen}" Padding="6,3"
                                                AutomationProperties.Name="{DynamicResource ui.PersonaEntfernen}"
                                                VerticalAlignment="Center" Click="RemovePersona_Click">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Angehängte Dateien -->
                                <WrapPanel x:Name="DocumentsPanel" Visibility="Collapsed" Margin="0,0,0,2"/>

                                <!-- Angehängtes Bild -->
                                <Border x:Name="AttachmentPanel" Visibility="Collapsed" Margin="0,0,0,8" Padding="6"
                                        CornerRadius="10" HorizontalAlignment="Left"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="AttachmentImage" Height="56" MaxWidth="140" Stretch="Uniform"/>
                                        <TextBlock x:Name="AttachmentText" VerticalAlignment="Center" Margin="10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Button Style="{StaticResource IconButton}" ToolTip="{DynamicResource ui.BildEntfernen}"
                                                VerticalAlignment="Center" Click="RemoveImage_Click">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <TextBox x:Name="InputBox" FontSize="15" Style="{StaticResource PlainTextBox}"
                                             Padding="2,4" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="48" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                             PreviewKeyDown="InputBox_PreviewKeyDown" TextChanged="InputBox_TextChanged"/>
                                    <TextBlock Text="{DynamicResource ui.NachrichtSchreiben}" FontSize="15" Margin="4,6,0,0" IsHitTestVisible="False"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding Text.IsEmpty, ElementName=InputBox, Converter={StaticResource BoolToVis}}"/>
                                </Grid>

                                <DockPanel Margin="0,6,0,0">
                                    <Button x:Name="ImageButton" Style="{StaticResource IconButton}" Click="ImageButton_Click"
                                            AutomationProperties.Name="{DynamicResource ui.DateiAnhaengen}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE723;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource ui.Datei}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TemplatesButton" Style="{StaticResource IconButton}" Click="TemplatesButton_Click"
                                            ToolTip="{DynamicResource ui.VorlagenUndPersonasOderIns}"
                                            AutomationProperties.Name="{DynamicResource ui.Vorlagen}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource ui.Vorlagen}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <CheckBox x:Name="HistoryCheck" IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center"
                                              Content="{DynamicResource ui.VerlaufMitsenden}"
                                              ToolTip="{DynamicResource ui.MitHakenKenntDasModell}"/>
                                    <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource SendButtonStyle}"
                                            ToolTip="{DynamicResource ui.SendenEnter}" Click="Send_Click"/>
                                    <Button x:Name="StopButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                            Margin="0,0,6,0" Visibility="Collapsed" ToolTip="{DynamicResource ui.AntwortAbbrechen}" Click="Stop_Click">
                                        <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                    </Button>
                                    <Grid/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Auswahl von Vorlagen und Personas (öffnet sich mit „/“ im Eingabefeld) -->
                        <Popup x:Name="TemplatePopup" PlacementTarget="{Binding ElementName=InputCard}" Placement="Top"
                               StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                            <Border CornerRadius="12" Padding="6" BorderThickness="1"
                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ui.VorlagenUndPersonasWaehlenEnter}" FontSize="11.5"
                                               Margin="8,2,8,6" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock x:Name="TemplatePickEmpty" Text="{DynamicResource ui.KeinePassendeVorlageAnlegenKannst}"
                                               Margin="8,0,8,6" Visibility="Collapsed" FontSize="13"/>
                                    <ListBox x:Name="TemplatePickList" MaxHeight="300" BorderThickness="0" Background="Transparent"
                                             PreviewMouseLeftButtonUp="TemplatePickList_MouseUp">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,1">
                                                    <TextBlock FontSize="13.5">
                                                        <Run Text="{Binding Kind, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Preview}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <TextBlock x:Name="StatusText" Grid.Row="3" HorizontalAlignment="Center" Margin="24,0,24,10"
                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{DynamicResource ui.EnterSendenUmschaltEnterNeue}"/>
                    </Grid>
                </TabItem>

                <!-- ========== Einstellungen ========== -->
                <TabItem Header="{DynamicResource ui.Einstellungen}">
                    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,24,32,24" MaxWidth="860" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource ui.Einstellungen}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18"
                                       Text="{DynamicResource ui.WoDasSprachmodellLaeuftWelches}"/>

                            <!-- Schritt-für-Schritt-Anleitung, solange noch nichts fertig eingerichtet ist -->
                            <Border x:Name="SetupGuide" Style="{StaticResource Card}" Background="#1A3B82F6" BorderBrush="#663B82F6"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="SetupGuideTitle" Style="{StaticResource Heading}" Text="{DynamicResource ui.SoGehtSLosIn}"/>
                                    <StackPanel x:Name="SetupSteps"/>
                                    <Button x:Name="SetupDoneButton" Content="{DynamicResource ui.LosGehtSZumChat}" Margin="0,12,0,0" Padding="14,6"
                                            HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}"
                                            Visibility="Collapsed" Click="SetupDone_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Kacheln -->
                            <UniformGrid Columns="3" Margin="0,0,-12,20">
                                <Border Style="{StaticResource Tile}" Background="#1F3B82F6">
                                    <StackPanel>
                                        <TextBlock x:Name="TileProvider" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{DynamicResource ui.AktiverAnbieter}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}" Background="#1F8B5CF6">
                                    <StackPanel>
                                        <TextBlock x:Name="TileModel" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TileModelHint" Text="{DynamicResource ui.AktivesModell}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}" Background="#1FF97316">
                                    <StackPanel>
                                        <TextBlock x:Name="TileChats" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource ui.GespeicherteChats}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Karte: Sprache -->
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <ComboBox x:Name="LanguageCombo" DockPanel.Dock="Right" Width="260" VerticalAlignment="Center"
                                              SelectionChanged="LanguageCombo_SelectionChanged" AutomationProperties.Name="Sprache / Language"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.Sprache}"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0" Text="{DynamicResource ui.SpracheHinweis}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Karte: Anbieter -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.Anbieter}"/>
                                    <TextBlock Style="{StaticResource Hint}">
                                        <Run Text="{DynamicResource ui.LokalAufDeinemRechnerBzw}"/>
                                    </TextBlock>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ListBox x:Name="ProviderList" VerticalAlignment="Top" SelectionChanged="ProviderList_SelectionChanged"
                                                 AutomationProperties.Name="{DynamicResource ui.Anbieter}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,3">
                                                        <TextBlock>
                                                            <Run Text="{Binding Info.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            <Run Text="{Binding ActiveMark, Mode=OneWay}"
                                                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <DockPanel>
                                        <Button x:Name="UseProviderButton" DockPanel.Dock="Right" Content="{DynamicResource ui.ImChatVerwenden}" Padding="14,5"
                                                Style="{StaticResource AccentButtonStyle}" Click="UseProvider_Click"
                                                ToolTip="{DynamicResource ui.SpeichernUndDiesenAnbieterMit}"/>
                                        <TextBlock x:Name="ProviderTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="ProviderActiveNote" FontSize="12.5" Margin="0,2,0,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock x:Name="ProviderHint" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
                                    <TextBlock x:Name="ProviderLinks" TextWrapping="Wrap"/>

                                    <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.ServerAdresse}"/>
                                    <TextBlock Style="{StaticResource Hint}">
                                        <Run Text="{DynamicResource ui.NormalerweisePasstDerStandardFuer}"/> <Run FontFamily="Consolas" Text="http://192.168.178.191:1234"/>.
                                    </TextBlock>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{DynamicResource ui.Standard}" Margin="8,0,0,0" Click="DefaultServer_Click"/>
                                        <TextBox x:Name="ServerBox"/>
                                    </DockPanel>

                                    <StackPanel x:Name="ApiKeyPanel">
                                        <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.APISchluessel}"/>
                                        <TextBlock Style="{StaticResource Hint}">
                                            <Run Text="{DynamicResource ui.DenSchluesselBekommstDuIn}"/>
                                            <Hyperlink x:Name="KeyLink" RequestNavigate="Link_RequestNavigate"><Run x:Name="KeyLinkText"/></Hyperlink><Run Text="{DynamicResource ui.ErWirdVerschluesseltGespeichertUnd}"/>
                                        </TextBlock>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged"
                                                         AutomationProperties.Name="{DynamicResource ui.APISchluessel}"/>
                                            <TextBox x:Name="ApiKeyPlain" Visibility="Collapsed" FontFamily="Cascadia Mono, Consolas"
                                                     AutomationProperties.Name="{DynamicResource ui.APISchluesselImKlartext}"/>
                                            <ToggleButton x:Name="ApiKeyReveal" Grid.Column="1" Margin="6,0,0,0" Padding="10,0"
                                                          ToolTip="{DynamicResource ui.SchluesselAnzeigenBzwWiederVerbergen}"
                                                          AutomationProperties.Name="{DynamicResource ui.SchluesselAnzeigen}">
                                                <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                            </ToggleButton>
                                        </Grid>
                                        <Border CornerRadius="8" Padding="12,8" Margin="0,8,0,0" Background="#1FF59E0B"
                                                BorderBrush="#66F59E0B" BorderThickness="1">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run FontWeight="SemiBold" Text="{DynamicResource ui.Wichtig}"/>
                                                <Run Text="{DynamicResource ui.SetzeBeimAnbieterUnbedingtEin2}"/>
                                                <Hyperlink Click="ShowHelp_Click"><Run Text="{DynamicResource ui.HilfeKostenAbsichern}"/></Hyperlink>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel x:Name="RegionPanel">
                                        <TextBlock Style="{StaticResource SubHeading}" Text="{DynamicResource ui.StandortDerRechenzentren}"/>
                                        <TextBlock Style="{StaticResource Hint}">
                                            <Run Text="{DynamicResource ui.LegtFestWoDeineAnfragen}"/><LineBreak/>
                                            <Run FontWeight="SemiBold" Text="{DynamicResource ui.UeberHosterAuswahlJederTarif}"/> <Run Text="{DynamicResource ui.DieAppLaesstNurHoster}"/><LineBreak/>
                                            <Run FontWeight="SemiBold" Text="{DynamicResource ui.GarantiertInRegionRouting}"/> <Run Text="{DynamicResource ui.OpenRouterSelbstStelltSicherDass}"/><Hyperlink NavigateUri="https://openrouter.ai/docs/guides/features/sovereign-ai"
                                                        RequestNavigate="Link_RequestNavigate"><Run Text="{DynamicResource ui.Details}"/></Hyperlink><Run Text="{DynamicResource ui.SonstKommtDerFehlerHTTP}"/>
                                        </TextBlock>
                                        <ComboBox x:Name="RegionCombo" DisplayMemberPath="Label" SelectedValuePath="Code"
                                                  SelectionChanged="RegionCombo_SelectionChanged"/>
                                    </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Karte: Modell (des links ausgewählten Anbieters) -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="ModelHeading" Style="{StaticResource Heading}" Text="{DynamicResource ui.Modell}"/>
                                    <TextBlock Style="{StaticResource Hint}">
                                        <Run Text="{DynamicResource ui.DieListeKommtDirektVom}"/>
                                        <Run FontWeight="SemiBold" Text="🖼"/> <Run Text="{DynamicResource ui.VerstehtBilder2}"/>
                                        <Run FontWeight="SemiBold" Text="●"/> <Run Text="{DynamicResource ui.IstGeradeGeladenUndAntwortet}"/>
                                        <Run FontWeight="SemiBold" Text="🎨"/> <Run Text="{DynamicResource ui.ErzeugtBilderMitDemSuchfeld}"/>
                                    </TextBlock>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="230"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox x:Name="ModelSearchBox" Padding="32,6,8,6" TextChanged="ModelSearch_TextChanged"/>
                                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="11,0,0,0"
                                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{DynamicResource ui.ModelleSuchenZBGemini}" Margin="33,0,0,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding Text.IsEmpty, ElementName=ModelSearchBox, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                        <ComboBox x:Name="ModelFilterCombo" Grid.Column="1" Margin="8,0,0,0" SelectedIndex="0"
                                                  SelectionChanged="ModelFilterCombo_SelectionChanged">
                                            <ComboBoxItem Content="{DynamicResource ui.AlleModelle}"/>
                                            <ComboBoxItem Content="{DynamicResource ui.ErzeugtBilder}"/>
                                            <ComboBoxItem Content="{DynamicResource ui.VerstehtBilder}"/>
                                            <ComboBoxItem Content="{DynamicResource ui.GeradeGeladen}"/>
                                        </ComboBox>
                                    </Grid>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{DynamicResource ui.ListeAktualisieren}" Margin="8,0,0,0"
                                                Click="ReloadModels_Click"/>
                                        <ComboBox x:Name="ModelCombo" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                  TextSearch.TextPath="Id" MaxDropDownHeight="420"
                                                  HorizontalAlignment="Stretch" SelectionChanged="ModelCombo_SelectionChanged"/>
                                    </DockPanel>
                                    <TextBlock x:Name="ModelFilterInfo" FontSize="12" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock x:Name="ModelHint" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Karte: System-Prompt -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.SystemPrompt}"/>
                                    <TextBlock Style="{StaticResource Hint}">
                                        <Run Text="{DynamicResource ui.EineFesteAnweisungDieDas}"/>
                                    </TextBlock>
                                    <TextBox x:Name="SystemPromptBox" Height="100"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    <CheckBox x:Name="AutoTitleCheck" Margin="0,12,0,0"
                                              Content="{DynamicResource ui.ChatTitelNachDerErsten}"
                                              ToolTip="{DynamicResource ui.EineKurzeZusatzanfrageAnDasselbe}"/>
                                </StackPanel>
                            </Border>

                            <!-- Karte: Vorlagen und Personas -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.VorlagenUndPersonas}"/>
                                    <TextBlock Style="{StaticResource Hint}">
                                        <Run Text="{DynamicResource ui.ImChat}"/> <Run FontWeight="SemiBold" Text="„/“"/> <Run Text="{DynamicResource ui.InsEingabefeldTippenOderKnopf}"/> <Run FontWeight="SemiBold" Text="{DynamicResource ui.Vorlage}"/> <Run Text="{DynamicResource ui.SetztIhrenTextInsEingabefeld}"/> <Run FontWeight="SemiBold" Text="{DynamicResource ui.Persona}"/> <Run Text="{DynamicResource ui.GiltFuerDenGanzenChat}"/>
                                    </TextBlock>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <DockPanel Margin="0,0,14,0">
                                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="{DynamicResource ui.Neu}" Padding="14,4" Click="NewTemplate_Click"/>
                                                <Button Content="{DynamicResource ui.Loeschen}" Padding="14,4" Margin="8,0,0,0" Click="DeleteTemplate_Click"/>
                                            </StackPanel>
                                            <ListBox x:Name="TemplateList" Height="230" SelectionChanged="TemplateList_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Kind, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <Run Text="  "/>
                                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                        <StackPanel x:Name="TemplateEditor" Grid.Column="1">
                                            <TextBlock Text="{DynamicResource ui.Name}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TemplateNameBox" TextChanged="TemplateField_Changed"/>
                                            <CheckBox x:Name="TemplatePersonaCheck" Margin="0,10,0,0" Checked="TemplateField_Changed"
                                                      Unchecked="TemplateField_Changed"
                                                      Content="{DynamicResource ui.PersonaGiltFuerDenGanzen}"/>
                                            <TextBlock Text="{DynamicResource ui.Text}" Margin="0,10,0,4"/>
                                            <TextBox x:Name="TemplateTextBox" Height="120" AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" TextChanged="TemplateField_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Karte: Feineinstellungen -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.Feineinstellungen}"/>
                                    <TextBlock Style="{StaticResource Hint}">
                                        <Run Text="{DynamicResource ui.SetzeEinenHakenUmEinen}"/>
                                    </TextBlock>
                                    <StackPanel x:Name="ParamsPanel"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="{DynamicResource ui.Speichern}" MinWidth="130" Padding="0,8" Click="SaveSettings_Click"
                                        ToolTip="{DynamicResource ui.AlleEinstellungenSpeichernDerAnbieter}"
                                        Style="{StaticResource AccentButtonStyle}"/>
                                <Button Content="{DynamicResource ui.AllesAufStandard}" Margin="8,0,0,0" Click="ResetParams_Click"/>
                                <TextBlock x:Name="SettingsStatus" Margin="14,0,0,0" MaxWidth="520"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========== Verbrauch ========== -->
                <TabItem Header="{DynamicResource ui.Verbrauch}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,24,32,24" MaxWidth="860" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource ui.Verbrauch}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18"
                                       Text="{DynamicResource ui.WieVieleAnfragenUndTokens}"/>

                            <!-- Deutlicher Hinweis: nur eine Schätzung -->
                            <Border Style="{StaticResource Card}" Background="#1FF59E0B" BorderBrush="#66F59E0B">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.NurEineSchaetzungKeineAbrechnung}"/>
                                    <TextBlock Style="{StaticResource Body}">
                                        <Run Text="{DynamicResource ui.DieZahlenZaehltFreeGuentherSelbst}"/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="{DynamicResource ui.DieExaktenKostenSiehstDu}"/>
                                        <Hyperlink NavigateUri="https://openrouter.ai/activity" RequestNavigate="Link_RequestNavigate"><Run Text="{DynamicResource ui.OpenRouter}"/></Hyperlink> ·
                                        <Hyperlink NavigateUri="https://platform.openai.com/usage" RequestNavigate="Link_RequestNavigate"><Run Text="{DynamicResource ui.OpenAI}"/></Hyperlink> ·
                                        <Hyperlink NavigateUri="https://platform.claude.com/usage" RequestNavigate="Link_RequestNavigate"><Run Text="{DynamicResource ui.Anthropic}"/></Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Kostenbremse -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.Kostenbremse}"/>
                                    <TextBlock Style="{StaticResource Hint}">
                                        <Run Text="{DynamicResource ui.EinEigenesLimitInFreeGuenther}"/>
                                    </TextBlock>
                                    <WrapPanel Margin="0,4,0,0">
                                        <TextBlock Text="{DynamicResource ui.ProTagUS}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="DailyBudgetBox" Width="90" Margin="0,0,24,0"/>
                                        <TextBlock Text="{DynamicResource ui.ProMonatUS}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="MonthlyBudgetBox" Width="90"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="BudgetHardCheck" Margin="0,12,0,0"
                                              Content="{DynamicResource ui.HartSperrenBeiErreichtemLimit}"/>
                                    <TextBlock x:Name="BudgetSpent" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="{DynamicResource ui.KostenbremseSpeichern}" Click="SaveBudget_Click"/>
                                        <TextBlock x:Name="BudgetStatus" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                                <TextBlock Style="{StaticResource Body}" Text="{DynamicResource ui.Zeitraum}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="UsagePeriodCombo" Width="200" SelectionChanged="UsagePeriod_SelectionChanged">
                                    <ComboBoxItem Content="{DynamicResource ui.Heute}"/>
                                    <ComboBoxItem Content="{DynamicResource ui.Letzte7Tage}"/>
                                    <ComboBoxItem Content="{DynamicResource ui.DieserMonat}" IsSelected="True"/>
                                    <ComboBoxItem Content="{DynamicResource ui.Letzte30Tage}"/>
                                    <ComboBoxItem Content="{DynamicResource ui.Gesamt}"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Kacheln -->
                            <UniformGrid Columns="3" Margin="0,0,-12,20">
                                <Border Style="{StaticResource Tile}" Background="#1F3B82F6">
                                    <StackPanel>
                                        <TextBlock x:Name="UsageRequestsTile" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource ui.Antworten}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}" Background="#1F8B5CF6">
                                    <StackPanel>
                                        <TextBlock x:Name="UsageTokensTile" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{DynamicResource ui.TokensGesendetErhalten}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}" Background="#1FF97316">
                                    <StackPanel>
                                        <TextBlock x:Name="UsageCostTile" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource ui.KostenUngefaehr}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Tabelle je Modell -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource ui.JeModell}"/>
                                    <ListView x:Name="UsageList" BorderThickness="0" Background="Transparent" Margin="0,4,0,0">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="{DynamicResource ui.Anbieter}" Width="130" DisplayMemberBinding="{Binding Provider}"/>
                                                <GridViewColumn Header="{DynamicResource ui.Modell}" Width="230" DisplayMemberBinding="{Binding Model}"/>
                                                <GridViewColumn Header="{DynamicResource ui.Antworten}" Width="80" DisplayMemberBinding="{Binding Requests}"/>
                                                <GridViewColumn Header="{DynamicResource ui.TokensEin}" Width="95" DisplayMemberBinding="{Binding InputTokens}"/>
                                                <GridViewColumn Header="{DynamicResource ui.TokensAus}" Width="95" DisplayMemberBinding="{Binding OutputTokens}"/>
                                                <GridViewColumn Header="{DynamicResource ui.Kosten}" Width="170" DisplayMemberBinding="{Binding Cost}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock x:Name="UsageEmpty" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed"
                                               Text="{DynamicResource ui.InDiesemZeitraumGabEs}"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0">
                                        <Run FontWeight="SemiBold" Text="{DynamicResource ui.SoEntstehenDieKosten}"/>
                                        <Run Text="{DynamicResource ui.GemeldetBetragDenDerAnbieter}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="{DynamicResource ui.ZaehlerZuruecksetzen}" Click="ClearUsage_Click"/>
                                        <TextBlock x:Name="UsageStatus" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========== Plugins ========== -->
                <TabItem Header="{DynamicResource ui.Plugins}">
                    <ScrollViewer x:Name="PluginsScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,24,32,24" MaxWidth="860" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource ui.Plugins}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18" TextWrapping="Wrap"
